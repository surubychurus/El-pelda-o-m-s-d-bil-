# Cadena de conexión de Neon (con sslmode=require)
DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require
# Secreto largo y aleatorio: openssl rand -hex 32
JWT_SECRET=cambia-esto
PORT=3100
# 127.0.0.1 = solo nginx puede llegar al servidor. Para probar desde el móvil en tu wifi: 0.0.0.0
HOST=127.0.0.1
